# Copy to .env and fill in. `openssl rand -hex 24` makes a good secret.

# Domain Caddy serves (TLS is automatic), or `http://localhost` for a local trial.
SITE_ADDRESS=http://localhost

# Hex only: it is embedded in a connection URL.
POSTGRES_PASSWORD=

# Web Push key: `npx web-push generate-vapid-keys`, keep the private one (the server serves the public one).
VAPID_PRIVATE_KEY=

# Days an undelivered message is kept before it is dropped (default 30). Apps keep a replaced
# signed prekey for 30 days: above 30, a first message that waited longer may be unreadable.
# MESSAGE_TTL_DAYS=30

# Optional call relay (docker compose --profile relay up -d).
# TURN_URLS=turn:turn.example.org:3478?transport=udp,stun:turn.example.org:3478
TURN_URLS=
TURN_SECRET=
TURN_REALM=
TURN_EXTERNAL_IP=

# Optional STUN when you run no relay. Empty = none: no third party learns who calls whom.
VITE_STUN_URL=

# Only to run on other ports.
# HTTP_PORT=80
# HTTPS_PORT=443
