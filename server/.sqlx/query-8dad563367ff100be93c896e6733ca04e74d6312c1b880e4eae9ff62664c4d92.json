  "query": "\n        UPDATE prekeys\n        SET used = true\n        WHERE device_id = $1 AND key_id = (\n            SELECT key_id FROM prekeys WHERE device_id = $1 AND used = false ORDER BY key_id LIMIT 1 FOR UPDATE SKIP LOCKED\n        )\n        RETURNING key_id, public_key\n        ",
